# Copy to .env and fill in to use a real LLM provider. Everything works
# with zero configuration (LLM_PROVIDER defaults to "mock").

LLM_PROVIDER=mock            # mock | openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

SIGNAL_SELF_CONSISTENCY_SAMPLES=3
RAG_TOP_K=3
CONTEXT_WINDOW_TURNS=12
LOG_LEVEL=INFO
